# Pitwall — example environment file.
# Copy to `.env` and fill in real values. The real `.env` is gitignored.
# This documents only the SHARED infrastructure variables. Each service adds its own
# (DB connection, SMTP creds, etc.) in its own README/section as it is built —
# do not invent service-specific vars here without a recorded decision.

# --- RabbitMQ (shared bus) ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=pitwall
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=/

# --- Observability ---
LOG_LEVEL=info            # structured JSON logs; one of: debug|info|warn|error

# --- Control Room ---
HEARTBEAT_INTERVAL_MS=1000
DOWN_AFTER_MISSED_HEARTBEATS=3

# --- Timing (Story 1.3 — Go service skeleton; Story 1.4 — outbox + relay; Story 1.5 — simulator) ---
SERVICE_NAME=timing
LIVENESS_FILE=/tmp/pitwall-timing.live   # touch-file the bus-only healthcheck reads
CONTRACT_DIR=/contract                   # where the /contract tree lives in the image
HEALTH_FRESHNESS_FACTOR=3                # healthcheck tolerates up to N missed heartbeats
SHUTDOWN_TIMEOUT_MS=5000                 # bound on graceful drain (NFR19)
DB_PATH=/data/timing.db                  # private SQLite DB (on the timing-data volume; survives restart)
OUTBOX_POLL_INTERVAL_MS=200              # relay poll backstop; a freshly-enqueued row also kicks the relay
# INSTANCE_ID=                            # optional; a per-process UUID is minted if unset

# --- Timing simulator (Story 1.5) + lap-validity filter (Story 1.6) ---
# The toggle defaults OFF in code; compose turns it ON for the local demo. When ON,
# the data-shaping knobs (DRIVERS/MEAN/STDDEV/LAPS) AND MIN_LAP_TIME_MS are REQUIRED —
# the service fails fast (never assumes) if any is unset. The pacing knobs are optional.
SIMULATOR_ENABLED=true                   # true|false (also accepts 1|0)
SIM_DRIVERS=8                            # N fixture drivers (>= 1) — FIXTURE masterIds, NOT an identity path
SIM_LAP_MEAN_MS=45000                    # normal-distribution mean lap time (ms)
SIM_LAP_STDDEV_MS=2000                   # normal-distribution stddev (ms)
SIM_SESSION_LAPS=10                      # counted laps per driver before the session ends (>= 1)
MIN_LAP_TIME_MS=10000                    # lap-validity rule (FR35): crossings closer than this are rejected as
                                         #   bounce/duplicate reads. Required when the simulator is on; MUST be
                                         #   below SIM_LAP_MEAN_MS or the loader fails fast.
SIM_TICK_MS=250                          # optional: wall-clock pacing between emitted events (default 250)
SIM_SESSION_GAP_MS=5000                  # optional: pause between sessions in the continuous loop (default 5000)
# SIM_SEED=                               # optional: set an integer for a reproducible session; unset = time-seeded

# --- Leaderboard (Story 1.7 — first consumer; live SSE trackside board) ---
# Consumes timing's lap.recorded off timing.events, dedupes via a durable inbox,
# folds best-lap standings, and pushes them to the browser over SSE (never polling).
# SERVICE_NAME / LIVENESS_FILE / DB_PATH / HTTP_ADDR are set per-service in compose
# (so they don't clash with Timing's). These are the leaderboard-specific knobs:
LEADERBOARD_HTTP_PORT=8080               # host port the trackside board is published on (loopback only)
CONSUME_PREFETCH=16                      # QoS bound on in-flight unacked deliveries (>= 1)
