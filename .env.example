# Pitwall — example environment file.
# Copy to `.env` and fill in real values. The real `.env` is gitignored.
# This documents only the SHARED infrastructure variables. Each service adds its own
# (DB connection, SMTP creds, etc.) in its own README/section as it is built —
# do not invent service-specific vars here without a recorded decision.

# --- RabbitMQ (shared bus) ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=pitwall
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=/

# --- Observability ---
LOG_LEVEL=info            # structured JSON logs; one of: debug|info|warn|error

# --- Control Room ---
HEARTBEAT_INTERVAL_MS=1000
DOWN_AFTER_MISSED_HEARTBEATS=3

# --- Timing (Story 1.3 — Go service skeleton; Story 1.4 — outbox + relay) ---
SERVICE_NAME=timing
LIVENESS_FILE=/tmp/pitwall-timing.live   # touch-file the bus-only healthcheck reads
CONTRACT_DIR=/contract                   # where the /contract tree lives in the image
HEALTH_FRESHNESS_FACTOR=3                # healthcheck tolerates up to N missed heartbeats
SHUTDOWN_TIMEOUT_MS=5000                 # bound on graceful drain (NFR19)
DB_PATH=/data/timing.db                  # private SQLite DB (on the timing-data volume; survives restart)
OUTBOX_POLL_INTERVAL_MS=200              # relay poll backstop; a freshly-enqueued row also kicks the relay
# INSTANCE_ID=                            # optional; a per-process UUID is minted if unset
