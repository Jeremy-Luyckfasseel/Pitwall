# Secrets / local config — never commit real values (see .env.example)
.env
.env.*
!.env.example
# local MCP config (e.g. VPS host) — never commit; this is a public repo
.mcp.json

# Dependencies / build output (per-service, polyglot — extend as services are added)
node_modules/
dist/
build/

# Exception: keep the Leaderboard SPA embed target present so `//go:embed all:dist`
# and `go build` compile WITHOUT a prior Vite build (CI's Go-only job, local Go work).
# The real bundle is produced by the Vite build (Docker node stage) and stays ignored;
# only the .gitkeep placeholder is tracked. (Re-include the dir, then ignore its
# contents, then keep the placeholder — gitignore's parent-directory rule.)
!/services/leaderboard/internal/web/dist/
/services/leaderboard/internal/web/dist/*
!/services/leaderboard/internal/web/dist/.gitkeep
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
bin/
obj/

# TypeScript incremental-build state (tsc -b) — a local cache, never committed
*.tsbuildinfo

# Go build/test artifacts (binaries are built in Docker; modules fetched fresh)
*.exe
*.test
*.out
# Runtime liveness touch-files (bus-only health) — never committed
*.live

# Logs & local data
*.log
data/
# Local SQLite databases (private per-service stores; WAL/SHM sidecars) — never committed
*.db
*.db-wal
*.db-shm

# BMAD
_bmad/
_bmad-output/

# IDEs & OS files
.vscode/
.idea/
.claude
*.stackdump

